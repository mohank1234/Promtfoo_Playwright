# Staging environment - TEMPLATE. Point at your real staging deployment of
# whatever RAG chat API you're benchmarking and fill in real credentials.
# Run against this environment with: APP_ENV=staging npm run eval

EMAIL=TODO
PASSWORD=TODO
LOGIN_KEY=TODO

LOGIN_URL=https://staging.example.com/auth/login
API_BASE_URL=https://staging.example.com
CONVERSATION_STREAM_PATH=/api/conversation/stream

MODEL=TODO
ENABLE_THINK=false

# Request timeouts (ms). REQUEST_TIMEOUT_MS covers login/create-chat;
# STREAM_TIMEOUT_MS covers the whole conversation stream (connect through
# final chunk) - both prevent a hung server from stalling the eval run.
REQUEST_TIMEOUT_MS=15000
STREAM_TIMEOUT_MS=60000
