# Development environment - points at the local mock Cortex Assist server
# (npm run mock-server). Everything here is fictional/fake and safe to
# commit: no real credentials, no real backend.

EMAIL=demo@acmecorp.example
PASSWORD=demo-password
LOGIN_KEY=demo-key-12345

LOGIN_URL=http://localhost:4000/auth/login
API_BASE_URL=http://localhost:4000
CONVERSATION_STREAM_PATH=/api/conversation/stream

MODEL=cortex/assist-1
ENABLE_THINK=false

# Request timeouts (ms). REQUEST_TIMEOUT_MS covers login/create-chat;
# STREAM_TIMEOUT_MS covers the whole conversation stream (connect through
# final chunk) - both prevent a hung server from stalling the eval run.
REQUEST_TIMEOUT_MS=15000
STREAM_TIMEOUT_MS=60000
