{
  "name": "rag-agent-benchmark",
  "version": "1.0.0",
  "description": "Promptfoo-based benchmark framework for a multi-agent RAG chat API, with a self-contained mock server so the whole pipeline runs end-to-end with zero external dependencies.",
  "main": "index.js",
  "scripts": {
    "mock-server": "node mock-server/server.js",
    "test": "npm run test:login && npm run test:agent",
    "test:login": "node Tests/testLogin.js",
    "test:agent": "node Tests/testAgent.js",
    "eval": "node scripts/runEval.js",
    "eval:raw": "promptfoo eval -c promptfooconfig.yaml -o reports/_adhoc/report.html -o reports/_adhoc/latest_eval.json",
    "export": "node scripts/exportResults.js",
    "report": "promptfoo view"
  },
  "keywords": [
    "promptfoo",
    "rag",
    "llm-eval",
    "benchmark",
    "ai-agent",
    "llm-testing",
    "multi-agent"
  ],
  "author": "krishna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohank1234/Promtfoo_Playwright.git"
  },
  "bugs": {
    "url": "https://github.com/mohank1234/Promtfoo_Playwright/issues"
  },
  "homepage": "https://github.com/mohank1234/Promtfoo_Playwright#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "promptfoo": "^0.121.20",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  }
}
