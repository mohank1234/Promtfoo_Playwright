# Shared across all environments (not environment-specific). Everything
# environment-specific (login, URLs, agent IDs, model) lives under
# config/environments/<APP_ENV>.env - see config/env.js.
#
# Copy this file to .env and fill in your own key. The mock API server
# (npm run mock-server) needs no setup at all - this key is only used by
# Promptfoo's llm-rubric grader to compare actual vs. expected answers.

OPENAI_API_KEY=sk-your-key-here

# Which environment to load by default when APP_ENV isn't set on the command line.
APP_ENV=development
